# ─── Assistant IA (Claude) ───────────────────────────────────
# Clé API : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle (facultatif) — par défaut claude-opus-5
# CLAUDE_MODEL=claude-opus-5

# ─── WhatsApp (Twilio) ───────────────────────────────────────
# Compte : https://console.twilio.com → Messaging → Try WhatsApp (bac à sable pour tester)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro expéditeur : bac à sable "whatsapp:+14155238886" ou votre numéro WhatsApp Business validé
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Votre numéro, qui reçoit les nouvelles commandes
OWNER_WHATSAPP=+221770000000
# Modèles approuvés par Meta (Content SID "HX…"), nécessaires en production pour écrire
# à une personne qui ne vous a pas écrit dans les dernières 24 h. Laisser vide en test.
TWILIO_TPL_NEW_ORDER=
TWILIO_TPL_ORDER_RECEIVED=
TWILIO_TPL_STATUS=
# Modèle « authentification » pour le code de connexion des clientes (Content SID HX…)
TWILIO_TPL_OTP=

# ─── Boutique ────────────────────────────────────────────────
# Adresse publique du site (liens dans les messages WhatsApp)
SITE_URL=http://localhost:5174
# Code PIN de l'espace gérant, exigé pour envoyer les messages de statut
ADMIN_PIN=2026
PORT=8787
# Codes de connexion : sans WhatsApp configuré, le code s'affiche à l'écran (mode test).
# Mettre OTP_DEV_MODE=0 en production pour l'interdire.
OTP_DEV_MODE=1
# Dossier des données (vitrine, voix, comptes, commandes) : à placer sur un disque persistant
# DATA_DIR=/var/data/fabima

# ─── Carte et recherche d'adresse (OpenStreetMap, gratuit, sans clé) ───
# Recherche au fil de la frappe (Photon) et adresse d'un point GPS (Nominatim).
# Les services publics conviennent pour démarrer ; pour un gros volume, utilisez
# une offre payante ou votre propre serveur et indiquez son adresse ici.
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
#
# Le fond de carte se règle côté site, dans un fichier .env à la racine de fabima-store :
#   VITE_MAP_TILES=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=VOTRE_CLE
#   VITE_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap
